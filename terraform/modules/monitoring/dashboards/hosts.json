{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": { "ClusterName": "${ecs_cluster_name}", "ServiceName": "ollama-service" },
          "metricName": "CPUUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0,
          "alias": "Ollama"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": { "ClusterName": "${ecs_cluster_name}", "ServiceName": "openwebui-service" },
          "metricName": "CPUUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "B",
          "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0,
          "alias": "OpenWebUI"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": { "ClusterName": "${ecs_cluster_name}", "ServiceName": "prometheus-service" },
          "metricName": "CPUUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "C",
          "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0,
          "alias": "Prometheus"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": { "ClusterName": "${ecs_cluster_name}", "ServiceName": "grafana-service" },
          "metricName": "CPUUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "D",
          "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0,
          "alias": "Grafana"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
