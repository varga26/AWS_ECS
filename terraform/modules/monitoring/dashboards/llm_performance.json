{
  "title": "LLM Performance (Ollama)",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Token Generation Speed (Tokens/sec)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "expr": "rate(ollama_generated_tokens_total[1m])",
          "legendFormat": "{{model}} (Generation)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prompt Evaluation Speed (Tokens/sec)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "expr": "rate(ollama_prompt_tokens_total[1m])",
          "legendFormat": "{{model}} (Prompt Eval)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Loaded Models",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "expr": "ollama_loaded_models",
          "legendFormat": "Models Loaded",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Duration (seconds)",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "expr": "rate(ollama_request_duration_seconds_sum[1m]) / rate(ollama_request_duration_seconds_count[1m])",
          "legendFormat": "{{model}} Avg Req Time",
          "refId": "A"
        }
      ]
    }
  ]
}
