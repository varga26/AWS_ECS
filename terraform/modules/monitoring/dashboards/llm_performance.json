{
  "title": "LLM Performance (Ollama)",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Token Generation Speed (Tokens/sec)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "rate(ollama_eval_count_total[1m])",
          "legendFormat": "{{model}} (Generation)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prompt Evaluation Speed (Tokens/sec)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "rate(ollama_prompt_eval_count_total[1m])",
          "legendFormat": "{{model}} (Prompt Eval)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Request Queue",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "ollama_queue_size",
          "legendFormat": "Requests in Queue",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model Load Duration (seconds)",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "rate(ollama_prompt_eval_duration_seconds_total[1m])",
          "legendFormat": "{{model}} Eval Time",
          "refId": "A"
        }
      ]
    }
  ]
}
