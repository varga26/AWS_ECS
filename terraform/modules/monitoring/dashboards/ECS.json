{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "TaskDefinitionFamily": "*",
            "ContainerName": "*"
          },
          "metricName": "CpuUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{TaskDefinitionFamily}} / {{ContainerName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "TaskDefinitionFamily": "*",
            "ContainerName": "*"
          },
          "metricName": "MemoryUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{TaskDefinitionFamily}} / {{ContainerName}}"
        }
      ]
    }
  ]
}