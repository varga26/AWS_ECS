{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilized (per container / AZ)",
      "description": "CpuUtilized from ECS/ContainerInsights via SEARCH, broken down by ContainerName and AvailabilityZone.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,TaskDefinitionFamily,ContainerName,AvailabilityZone} ClusterName=\"${ecs_cluster_name}\" MetricName=\"CpuUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ContainerName}} / {{AvailabilityZone}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilized (per container / AZ)",
      "description": "MemoryUtilized from ECS/ContainerInsights via SEARCH, broken down by ContainerName and AvailabilityZone.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,TaskDefinitionFamily,ContainerName,AvailabilityZone} ClusterName=\"${ecs_cluster_name}\" MetricName=\"MemoryUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ContainerName}} / {{AvailabilityZone}}"
        }
      ]
    }
  ]
}