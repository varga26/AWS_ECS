{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never"
          },
          "displayName": "${__field.labels.TaskDefinitionFamily} - ${__field.labels.TaskId}"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "id": "queryA",
          "metricEditorMode": 1,
          "metricQueryType": 2,
          "queryMode": "Logs",
          "region": "default",
          "expression": "filter Type=\"Task\"\n| stats avg(CpuUtilized) by bin(1m), TaskDefinitionFamily, TaskId",
          "logGroupNames": ["/aws/ecs/containerinsights/${ecs_cluster_name}/performance"],
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never"
          },
          "displayName": "${__field.labels.TaskDefinitionFamily} - ${__field.labels.TaskId}"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "id": "queryB",
          "metricEditorMode": 1,
          "metricQueryType": 2,
          "queryMode": "Logs",
          "region": "default",
          "expression": "filter Type=\"Task\"\n| stats avg(MemoryUtilized) by bin(1m), TaskDefinitionFamily, TaskId",
          "logGroupNames": ["/aws/ecs/containerinsights/${ecs_cluster_name}/performance"],
          "refId": "A"
        }
      ]
    }
  ]
}