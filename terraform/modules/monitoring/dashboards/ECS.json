{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilized — per Container",
      "description": "CpuUtilized per container. Dimension group: ClusterName, ServiceName, TaskDefinitionFamily, ContainerName.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "id": "cpuByContainer",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName,TaskDefinitionFamily,ContainerName} ClusterName=\"${ecs_cluster_name}\" MetricName=\"CpuUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ContainerName}} / {{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Utilized — per Availability Zone",
      "description": "CpuUtilized per AZ. Dimension group: ClusterName, ServiceName, TaskDefinitionFamily, AvailabilityZone.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "id": "cpuByAZ",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName,TaskDefinitionFamily,AvailabilityZone} ClusterName=\"${ecs_cluster_name}\" MetricName=\"CpuUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ServiceName}} / {{AvailabilityZone}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilized — per Container",
      "description": "MemoryUtilized per container. Dimension group: ClusterName, ServiceName, TaskDefinitionFamily, ContainerName.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "id": "memByContainer",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName,TaskDefinitionFamily,ContainerName} ClusterName=\"${ecs_cluster_name}\" MetricName=\"MemoryUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ContainerName}} / {{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilized — per Availability Zone",
      "description": "MemoryUtilized per AZ. Dimension group: ClusterName, ServiceName, TaskDefinitionFamily, AvailabilityZone.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "id": "memByAZ",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName,TaskDefinitionFamily,AvailabilityZone} ClusterName=\"${ecs_cluster_name}\" MetricName=\"MemoryUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ServiceName}} / {{AvailabilityZone}}"
        }
      ]
    }
  ]
}