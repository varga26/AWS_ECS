{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilized — per Task Family (ECS/ContainerInsights)",
      "description": "ECS/ContainerInsights CpuUtilized. Metrics are published at the {ClusterName, ServiceName, TaskDefinitionFamily} level — this is the finest granularity available for CPU/Memory in ContainerInsights without the CloudWatch agent sidecar.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*",
            "TaskDefinitionFamily": "*"
          },
          "metricName": "CpuUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{TaskDefinitionFamily}} ({{ServiceName}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilized — per Task Family (ECS/ContainerInsights)",
      "description": "ECS/ContainerInsights MemoryUtilized. Published at {ClusterName, ServiceName, TaskDefinitionFamily} level.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*",
            "TaskDefinitionFamily": "*"
          },
          "metricName": "MemoryUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{TaskDefinitionFamily}} ({{ServiceName}})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running Task Count — per Service",
      "description": "Number of running ECS tasks per service (ECS/ContainerInsights).",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "RunningTaskCount",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Utilization — per Service (AWS/ECS)",
      "description": "Standard AWS/ECS CPUUtilization at service level. Confirmed available.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "CPUUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization — per Service (AWS/ECS)",
      "description": "Standard AWS/ECS MemoryUtilization at service level. Confirmed available.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "MemoryUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    }
  ]
}