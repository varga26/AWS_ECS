{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilized — per Container / AZ",
      "description": "Per-container CPU utilization from ECS task metadata endpoint via Prometheus. Labels: container_name, az, task_family.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "ecs_container_cpu_utilized{cluster=\"${ecs_cluster_name}\"}",
          "legendFormat": "{{container_name}} / {{az}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilized — per Container / AZ",
      "description": "Per-container memory utilization % from ECS task metadata endpoint via Prometheus.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "100 * ecs_container_memory_utilized_bytes{cluster=\"${ecs_cluster_name}\"} / ecs_container_memory_limit_bytes{cluster=\"${ecs_cluster_name}\"}",
          "legendFormat": "{{container_name}} / {{az}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running Containers — per Container / AZ",
      "description": "Number of running instances per container per Availability Zone (from Prometheus ecs-metrics sidecar).",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "count by (container_name, az) (ecs_container_cpu_utilized{cluster=\"${ecs_cluster_name}\"})",
          "legendFormat": "{{container_name}} / {{az}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Utilization — per Service (AWS/ECS)",
      "description": "Standard AWS/ECS CPUUtilization at service level (confirmed available).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "CPUUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization — per Service (AWS/ECS)",
      "description": "Standard AWS/ECS MemoryUtilization at service level (confirmed available).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "MemoryUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    }
  ]
}