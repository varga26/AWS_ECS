{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "expression": "SEARCH('Namespace=\"ECS/ContainerInsights\" MetricName=\"CpuUtilized\" ClusterName=\"${ecs_cluster_name}\"', 'Average', 60)",
          "metricQueryType": 1,
          "period": "60",
          "refId": "A",
          "region": "default"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "expression": "SEARCH('Namespace=\"ECS/ContainerInsights\" MetricName=\"MemoryUtilized\" ClusterName=\"${ecs_cluster_name}\"', 'Average', 60)",
          "metricQueryType": 1,
          "period": "60",
          "refId": "A",
          "region": "default"
        }
      ]
    }
  ]
}
