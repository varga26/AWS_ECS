{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilized — per Container",
      "description": "CpuUtilized per container. ServiceName wildcard forces ListMetrics to match only service/container-level metrics.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*",
            "TaskDefinitionFamily": "*",
            "ContainerName": "*"
          },
          "metricName": "CpuUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ContainerName}} / {{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Utilized — per Availability Zone",
      "description": "CpuUtilized per AZ. ServiceName wildcard forces ListMetrics to task/AZ-level metrics.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*",
            "TaskDefinitionFamily": "*",
            "AvailabilityZone": "*"
          },
          "metricName": "CpuUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}} / {{AvailabilityZone}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilized — per Container",
      "description": "MemoryUtilized per container. ServiceName wildcard forces ListMetrics to match only service/container-level metrics.",
