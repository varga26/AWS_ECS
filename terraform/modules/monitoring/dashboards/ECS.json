{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilized — per Container",
      "description": "ECS/ContainerInsights CpuUtilized. Correct dimension set: {ClusterName, TaskDefinitionFamily, ContainerName} — no ServiceName (AWS docs confirmed).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,TaskDefinitionFamily,ContainerName} ClusterName=\"${ecs_cluster_name}\" MetricName=\"CpuUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ContainerName}} / {{TaskDefinitionFamily}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilized — per Container",
      "description": "ECS/ContainerInsights MemoryUtilized. Correct dimension set: {ClusterName, TaskDefinitionFamily, ContainerName} — no ServiceName (AWS docs confirmed).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{ECS/ContainerInsights,ClusterName,TaskDefinitionFamily,ContainerName} ClusterName=\"${ecs_cluster_name}\" MetricName=\"MemoryUtilized\"', 'Average', 60)",
          "refId": "A",
          "alias": "{{ContainerName}} / {{TaskDefinitionFamily}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running Task Count — per Service",
      "description": "ECS/ContainerInsights RunningTaskCount per service. Confirmed working.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "RunningTaskCount",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Utilization — per Service (AWS/ECS)",
      "description": "Standard AWS/ECS CPUUtilization. Confirmed working.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "CPUUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization — per Service (AWS/ECS)",
      "description": "Standard AWS/ECS MemoryUtilization. Confirmed working.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "dimensions": {
            "ClusterName": "${ecs_cluster_name}",
            "ServiceName": "*"
          },
          "metricName": "MemoryUtilization",
          "namespace": "AWS/ECS",
          "period": "60",
          "region": "default",
          "statistic": "Average",
          "refId": "A",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "alias": "{{ServiceName}}"
        }
      ]
    }
  ]
}