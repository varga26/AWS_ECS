{
  "title": "ECS Containers CPU & Memory (ADOT)",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "Cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
        "query": "label_values(container_cpu_usage_total, ClusterName)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
        "query": "label_values(container_cpu_usage_total{ClusterName=\"$Cluster\"}, ServiceName)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "AZ",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
        "query": "label_values(container_cpu_usage_total{ClusterName=\"$Cluster\"}, aws_availability_zone)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "Container",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
        "query": "label_values(container_cpu_usage_total{ClusterName=\"$Cluster\", aws_availability_zone=~\"$AZ\"}, container_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage Rate — per Container / AZ",
      "description": "Rate of CPU seconds consumed per container, grouped by Availability Zone.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "rate(container_cpu_usage_total{ClusterName=\"$Cluster\", ServiceName=~\"$Service\", aws_availability_zone=~\"$AZ\", container_name=~\"$Container\"}[5m])",
          "legendFormat": "{{container_name}} - {{aws_availability_zone}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage — per Container / AZ",
      "description": "Memory consumed (in bytes) per container, grouped by Availability Zone.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
          "expr": "container_memory_usage{ClusterName=\"$Cluster\", ServiceName=~\"$Service\", aws_availability_zone=~\"$AZ\", container_name=~\"$Container\"}",
          "legendFormat": "{{container_name}} - {{aws_availability_zone}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      }
    }
  ]
}