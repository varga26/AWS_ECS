{
  "title": "ECS Containers",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Utilization (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_uid}"
          },
          "id": "queryA",
          "metricEditorMode": 1,
          "metricQueryType": 2,
          "queryMode": "Logs",
          "region": "default",
          "expression": "filter Type=\"Container\"\n| stats avg(CpuUtilized) by bin(1m), ContainerName, TaskId",
          "logGroupNames": [
            "/aws/ecs/containerinsights/${ecs_cluster_name}/performance"
          ],
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Utilization (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch_uid}"
          },
          "id": "queryB",
          "metricEditorMode": 1,
          "metricQueryType": 2,
          "queryMode": "Logs",
          "region": "default",
          "expression": "filter Type=\"Container\"\n| stats avg(MemoryUtilized) by bin(1m), ContainerName, TaskId",
          "logGroupNames": [
            "/aws/ecs/containerinsights/${ecs_cluster_name}/performance"
          ],
          "refId": "A"
        }
      ]
    }
  ]
}